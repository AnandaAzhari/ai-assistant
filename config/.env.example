# AI Assistant environment template
# Copy this file to .env on the local machine and fill in real values.
# NEVER commit real secrets to GitHub.

APP_ENV=development
DATABASE_PATH=data/assistant.db
LOG_LEVEL=INFO

# Local document output (runtime files; ignored by Git)
DOCUMENT_WORKSPACE=workspace/documents

# Model providers
# DeepSeek V4.1 Flash: official API model name is `deepseek-flash`.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Research Manager
# OpenAlex dapat dicoba tanpa API key; isi key bila nanti dibutuhkan untuk limit/production.
OPENALEX_API_KEY=
# Crossref tidak wajib key. Email opsional direkomendasikan untuk polite pool.
CROSSREF_MAILTO=
RESEARCH_HTTP_TIMEOUT=15

# Future providers / Lead Agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google Sheets mirror sync (Apps Script Web App)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SYNC_SECRET=

# Telegram Admin
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_ADMIN_CHAT_ID=

# Messaging / future customer channels
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=

# Admin identity / approvals (legacy/general fallback)
ADMIN_USER_ID=
APPROVAL_CHANNEL=telegram

# Cost limits
DAILY_API_BUDGET_USD=2
MONTHLY_API_BUDGET_USD=20
