# AI Assistant environment template
# Copy this file to .env on the local machine and fill in real values.
# NEVER commit real secrets to GitHub.

APP_ENV=development
DATABASE_PATH=data/assistant.db
LOG_LEVEL=INFO

# Local document output (runtime files; ignored by Git)
DOCUMENT_WORKSPACE=workspace/documents

# Model providers
# DeepSeek V4.1 Flash: official API model name is `deepseek-flash`.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Research Manager
# OpenAlex dapat dicoba tanpa API key; isi key bila nanti dibutuhkan untuk limit/production.
OPENALEX_API_KEY=
# Crossref tidak wajib key. Email opsional direkomendasikan untuk polite pool.
CROSSREF_MAILTO=
RESEARCH_HTTP_TIMEOUT=15

# Future providers / Lead Agent
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google Sheets mirror sync (Apps Script Web App)
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_SYNC_SECRET=

# Telegram Admin: chat pribadi owner. Jika bot sudah ada, gunakan token bot tersebut.
# Simpan nilai hanya di .env lokal; jangan kirim token ke chat atau GitHub.
# CHAT_ID boleh kosong untuk chat pribadi dengan USER_ID yang sama.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_USER_ID=
TELEGRAM_ADMIN_CHAT_ID=

# WhatsApp Customer Adapter (Fase 4, lihat docs/roadmap_customer_channel_v1.md)
# Provider: WhatsApp Business Platform Cloud API resmi dari Meta (bukan BSP pihak
# ketiga) — lihat app/whatsapp.py untuk alasannya.
# Didapat dari Meta Business Manager setelah nomor bisnis diverifikasi:
WHATSAPP_PROVIDER=meta_cloud_api
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Bebas ditentukan sendiri (string acak), dipakai untuk handshake verifikasi webhook GET:
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# App Secret dari Meta App Dashboard, dipakai memverifikasi header X-Hub-Signature-256:
WHATSAPP_APP_SECRET=
# Folder tempat file dari pelanggan disimpan SETELAH divalidasi (app/attachment_guard.py) —
# bukan folder kerja agent. Opsional, default "data/quarantine" kalau dikosongkan.
ATTACHMENT_QUARANTINE_DIR=

# Admin identity / approvals (legacy/general fallback)
ADMIN_USER_ID=
APPROVAL_CHANNEL=telegram

# Cost limits
DAILY_API_BUDGET_USD=2
MONTHLY_API_BUDGET_USD=20

