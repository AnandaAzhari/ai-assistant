# AI Assistant environment template
# Copy this file to .env on the local machine and fill in real values.
# NEVER commit real secrets to GitHub.

APP_ENV=development
DATABASE_PATH=data/assistant.db
LOG_LEVEL=INFO

# Model providers
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Messaging / remote channels
TELEGRAM_BOT_TOKEN=
WHATSAPP_PROVIDER=
WHATSAPP_API_TOKEN=

# Admin identity / approvals
ADMIN_USER_ID=
APPROVAL_CHANNEL=local

# Cost limits
DAILY_API_BUDGET_USD=2
MONTHLY_API_BUDGET_USD=20
